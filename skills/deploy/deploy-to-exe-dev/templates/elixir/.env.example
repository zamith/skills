# Copy to .env on the VM (never commit .env). Replace {{APP}} / {{VM}}.
POSTGRES_USER={{APP}}
POSTGRES_PASSWORD=changeme
POSTGRES_DB={{APP}}_prod

# Public host the exe.dev proxy serves. Must match the VM name.
PHX_HOST={{VM}}.exe.xyz
PORT=4000
POOL_SIZE=10

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=generate_with_mix_phx.gen.secret
